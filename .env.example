# Backend API base URL — required for apiFetch (src/lib/apiClient.ts)
VITE_API_BASE_URL=http://localhost:3000

# Stripe price IDs — sent as `priceId` to POST /billing/checkout (BE-030, FE-016).
# Never hardcoded in the frontend; the backend re-validates against its own
# whitelist. Leave empty in development: the upgrade CTA surfaces a config
# error instead of starting checkout.
VITE_STRIPE_PRICE_MONTHLY_ID=
VITE_STRIPE_PRICE_ANNUAL_ID=
