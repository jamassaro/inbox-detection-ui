# Inbox Detective — frontend environment (copy to .env and adjust)
#
# Backend API base URL. Required in live mode: apiFetch throws without it.
# Even with VITE_USE_MOCKS=true the value must be set (any placeholder works,
# e.g. http://localhost:3000) — the mock layer intercepts before the network.
VITE_API_BASE_URL=http://localhost:3000

# Mock mode (default: false = live API). Set to 'true' to develop without a
# backend: the app renders from an in-memory, contract-faithful mock API
# (src/mocks/mockApi.ts) — signed in as a Pro user with sample discoveries.
# In mock mode you can also set localStorage['mock:plan'] = 'free' to exercise
# Free-gated surfaces without a rebuild.
VITE_USE_MOCKS=false

# Stripe price IDs — POST /billing/checkout (BE-030, FE-016). Only needed
# when exercising the upgrade flow against a live backend.
VITE_STRIPE_PRICE_MONTHLY_ID=
VITE_STRIPE_PRICE_ANNUAL_ID=
