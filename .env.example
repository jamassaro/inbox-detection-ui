# Inbox Detective — frontend environment (copy to .env and adjust)
#
# Backend API base URL.
#   - Empty (same origin) is the recommended setup and what production uses
#     (.env.production): the backend is reached through the frontend's own
#     origin so the httpOnly session cookie stays first-party. Production:
#     Firebase Hosting rewrites (firebase.json). Dev: the Vite proxy
#     (vite.config.ts), targeting VITE_DEV_PROXY_TARGET.
#   - A full URL (e.g. http://localhost:8080 for a local backend) calls that
#     host directly; the backend must then allow this origin in its CORS list.
#   - UNSET is a misconfiguration: apiFetch throws.
VITE_API_BASE_URL=
# Dev proxy target when VITE_API_BASE_URL is empty (default: the Cloud Run URL).
# VITE_DEV_PROXY_TARGET=https://inbox-api-232545026192.us-central1.run.app

# Mock mode. The landing page's "Try the demo" button turns demo mode on at
# runtime (per tab); setting this to 'true' forces it for every load, for local
# development without a backend. Default: false (live API).
VITE_USE_MOCKS=false

# Stripe price IDs — POST /billing/checkout (BE-030, FE-016). Only needed
# when exercising the upgrade flow against a live backend.
VITE_STRIPE_PRICE_MONTHLY_ID=
VITE_STRIPE_PRICE_ANNUAL_ID=
